# Required environment variables for SubmitReport
# These are set automatically by Appwrite, but listed here for reference.
# See the Appwrite console → Functions → SubmitReport → Settings → Variables.

APPWRITE_DATABASE_ID=your_database_id
BLOCKLIST_COLLECTION_ID=your_domains_collection_id
VOTES_COLLECTION_ID=your_votes_collection_id
BUILD_BLOCKLISTS_ID=your_build_blocklists_function_id
TRUSTED_DOMAINS_COLLECTION_ID=your_trusted_domains_collection_id
